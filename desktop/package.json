{
  "name": "folklard-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Folklard desktop client",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.folklard.auroria",
    "productName": "Folklard",
    "asar": true,
    "files": [
      "main.cjs",
      "window-controller.cjs",
      "offline.html",
      "offline.css",
      "assets/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "Folklard-${os}-${arch}-${version}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/snowLH/card-realms.git"
  }
}
